# >>> devkit:core >>>
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,xml,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
end_of_line = lf
# <<< devkit:core <<<

# >>> devkit:shared/dotnet >>>
[*.{csproj,props,targets,razor}]
indent_size = 2

[*.cs]
# Namespaces and usings
dotnet_style_namespace_match_folder = true:warning
dotnet_diagnostic.IDE0130.severity = warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# 'this.' qualification off
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Language keywords over BCL type names
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# var
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression-bodied members: methods no, everything small yes
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# Braces and conditionals
csharp_prefer_braces = true:warning
dotnet_style_prefer_conditional_expression_over_assignment = false:suggestion

# New line preferences
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# EF writes these files and rewrites them whenever the model changes, so
# formatting or style rules would fight the tool rather than help a reader.
[**/Migrations/*.cs]
generated_code = true

# EF6 generates this one once and a human then maintains its Seed method, so it
# stays ordinary source. It must follow the section above: the later one wins.
[**/Migrations/Configuration.cs]
generated_code = false
# <<< devkit:shared/dotnet <<<

# >>> devkit:stack/dotnet-core >>>
[*.cs]
# Language features that need C# 10 or later, so they are not in the shared
# block: .NET Framework targets cannot rely on them.
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
# <<< devkit:stack/dotnet-core <<<
