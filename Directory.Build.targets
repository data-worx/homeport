<Project>

  <!-- A project that sets TrackPublicApi lists every public member in
       PublicAPI.Shipped.txt or PublicAPI.Unshipped.txt (ADR-0018). The
       analyzer runs at build time and flows to no caller, so it is no
       reference of the project: it is added here, not in the project file. -->
  <ItemGroup Condition="'$(TrackPublicApi)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- A project that becomes an image sets ShipsThirdPartyNotices, and its
       publish - so its image, under /app/ - carries the one notices file of
       the repository root (dotnet-core.notices). No Exists condition: a
       missing file fails the publish instead of shipping an image without it. -->
  <ItemGroup Condition="'$(ShipsThirdPartyNotices)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md"
          Link="THIRD-PARTY-NOTICES.md"
          CopyToPublishDirectory="PreserveNewest"
          CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
