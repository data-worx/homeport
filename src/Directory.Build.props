<Project>

  <!-- Only what no project file sets belongs here. MSBuild imports this file
       before a project file's own properties, so a value the project file sets
       wins - which is why the target framework, Nullable and ImplicitUsings
       stay in each .csproj, where dotnet new writes them (dotnet-core.compiler). -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Own images are built on chiseled .NET base images (ADR-0009): no shell,
       no package manager, non-root by default. Without InvariantGlobalization
       the SDK picks the -extra variant, which keeps ICU and time zone data.
       Only `dotnet publish -t:PublishContainer` reads it. -->
  <PropertyGroup>
    <ContainerFamily>noble-chiseled</ContainerFamily>
  </PropertyGroup>

</Project>
