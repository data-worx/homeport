<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one test library dotnet.tests allows: helpers several test projects
       share. It holds no tests, and only test projects reference it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Aspire.StackExchange.Redis" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Homeport.Shared.Authentication\Homeport.Shared.Authentication.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="EInvoicing\Invoices\*.xml" LogicalName="Homeport.Testing.EInvoicing.Invoices.%(Filename)%(Extension)" />
    <!-- The instances of the KoSIT XRechnung test suite, named by their path
         below TestSuite/ with forward slashes, as upstream names them. -->
    <EmbeddedResource Include="EInvoicing\TestSuite\**\*.xml" LogicalName="Homeport.Testing.EInvoicing.TestSuite.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
