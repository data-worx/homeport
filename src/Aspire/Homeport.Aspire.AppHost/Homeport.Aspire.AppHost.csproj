<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>homeport-apphost</UserSecretsId>
    <!-- ASPIRE010: the AppHost runs and publishes through `dotnet run`; nothing
         here needs the Aspire CLI bundle. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Docker" />
    <PackageReference Include="Aspire.Hosting.Keycloak" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.Valkey" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Echo\Homeport.Modules.Echo.Api\Homeport.Modules.Echo.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A library, not a resource: the AppHost reads its health paths. -->
    <ProjectReference Include="..\..\Shared\Homeport.Shared.ServiceDefaults\Homeport.Shared.ServiceDefaults.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
