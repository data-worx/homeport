<Project Sdk="Microsoft.NET.Sdk">

  <!-- References nothing (ADR-0018): what Homeport's services share and never
       ship, so every service takes it without taking anything else. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
