<Project Sdk="Microsoft.NET.Sdk">

  <!-- References nothing (ADR-0018): it is shipped with the SDK, and a caller
       takes the wire types without taking anything else with them. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TrackPublicApi>true</TrackPublicApi>
    <!-- The XML docs travel with the package to every caller, and module
         hosts take them into their OpenAPI documents. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
