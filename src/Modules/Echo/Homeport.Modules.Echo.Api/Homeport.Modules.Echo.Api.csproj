<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Becomes an image: carries THIRD-PARTY-NOTICES.md (Directory.Build.targets). -->
    <ShipsThirdPartyNotices>true</ShipsThirdPartyNotices>
    <!-- The image name, locally and in GHCR: the service.name of the component. -->
    <ContainerRepository>homeport-module-echo</ContainerRepository>
  </PropertyGroup>

  <!-- Referenced directly, not only through the SDK: that switches on the
       source generator that takes the XML docs into the OpenAPI document. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Sdk\Homeport.Sdk\Homeport.Sdk.csproj" />
    <ProjectReference Include="..\..\..\Shared\Homeport.Shared.Client\Homeport.Shared.Client.csproj" />
    <ProjectReference Include="..\Homeport.Modules.Echo.Infrastructure\Homeport.Modules.Echo.Infrastructure.csproj" />
  </ItemGroup>

</Project>
