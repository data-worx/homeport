<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Data, not code: versioned with the module, not overridable by the operator. -->
  <ItemGroup>
    <EmbeddedResource Include="RuleSets\rule-sets.json" LogicalName="Homeport.Modules.EInvoicing.Domain.RuleSets.rule-sets.json" />
    <EmbeddedResource Include="Model\business-terms.json" LogicalName="Homeport.Modules.EInvoicing.Domain.Model.business-terms.json" />
    <!-- The XML schemas of UBL 2.1 and CII D16B, unchanged as KoSIT ships them;
         named by their path below Schemas/, with / on every platform, so their
         relative imports resolve among the embedded files. -->
    <EmbeddedResource Include="Schemas\**\*.xsd" LogicalName="Homeport.Modules.EInvoicing.Domain.Schemas/$([System.String]::new('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\Homeport.Shared.Contracts\Homeport.Shared.Contracts.csproj" />
  </ItemGroup>

</Project>
