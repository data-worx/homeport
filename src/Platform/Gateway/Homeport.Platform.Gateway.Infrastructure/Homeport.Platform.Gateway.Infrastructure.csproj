<Project Sdk="Microsoft.NET.Sdk">

  <!-- The gateway's signing key, the service tokens it issues with it, the
       registry and control plane clients, the publishing of usage events and
       the token buckets in Valkey. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Homeport.Platform.Gateway.Infrastructure.Tests.Integration" />
    <InternalsVisibleTo Include="Homeport.Platform.Gateway.Infrastructure.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Run inside Valkey, so it is atomic across every gateway replica. -->
    <EmbeddedResource Include="Throttling/token-bucket.lua" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.StackExchange.Redis" />
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <!-- Compiles the code Wolverine generates at start-up. -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\Homeport.Shared.Authentication\Homeport.Shared.Authentication.csproj" />
    <ProjectReference Include="..\..\..\Shared\Homeport.Shared.Internal\Homeport.Shared.Internal.csproj" />
    <ProjectReference Include="..\Homeport.Platform.Gateway.Application\Homeport.Platform.Gateway.Application.csproj" />
  </ItemGroup>

</Project>
