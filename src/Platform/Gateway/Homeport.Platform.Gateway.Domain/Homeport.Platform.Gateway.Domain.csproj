<Project Sdk="Microsoft.NET.Sdk">

  <!-- Empty: the gateway forwards on static configuration and decides nothing
       yet. Its rules arrive with routing from the registry (#42) and
       throttling (#48), so it is cut ahead of them. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
