<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Becomes an image: carries THIRD-PARTY-NOTICES.md (Directory.Build.targets). -->
    <ShipsThirdPartyNotices>true</ShipsThirdPartyNotices>
    <!-- The image name, locally and in GHCR: the service.name of the component. -->
    <ContainerRepository>homeport-metering</ContainerRepository>
    <!-- The XML docs of the controllers become the OpenAPI document
         (dotnet-core.web); CS1591 stays off, the rule covers endpoints only. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Homeport.Platform.Metering.Api.Tests.Integration" />
  </ItemGroup>

  <ItemGroup>
    <!-- Its source generator takes the XML docs into the OpenAPI document. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <!-- Compiles the handlers Wolverine generates at start-up. -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\Homeport.Shared.Authentication\Homeport.Shared.Authentication.csproj" />
    <ProjectReference Include="..\..\..\Shared\Homeport.Shared.Client\Homeport.Shared.Client.csproj" />
    <ProjectReference Include="..\..\..\Shared\Homeport.Shared.Internal\Homeport.Shared.Internal.csproj" />
    <ProjectReference Include="..\..\..\Shared\Homeport.Shared.ServiceDefaults\Homeport.Shared.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Homeport.Platform.Metering.Infrastructure\Homeport.Platform.Metering.Infrastructure.csproj" />
  </ItemGroup>

</Project>
