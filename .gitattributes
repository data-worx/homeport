# Normalise all text files to LF in the repository and on checkout, so the
# .editorconfig `end_of_line = lf` rule holds on every platform.
* text=auto eol=lf

# Shell scripts must stay LF to run under bash everywhere.
*.sh text eol=lf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
